name: MCP Scan

on:
  push:
    branches: [main]
  pull_request:

jobs:
  scan:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repo
      uses: actions/checkout@v3

    - name: Install Rust (for building from source, optional)
      uses: actions-rs/toolchain@v1
      with:
        toolchain: stable
        override: true

    - name: Install MCP_Scanner binary
      run: |
        curl -sSL https://github.com/beejak/MCP_Scanner/releases/latest/download/mcp-sentinel-linux-x86_64 -o mcp-sentinel
        chmod +x mcp-sentinel
        sudo mv mcp-sentinel /usr/local/bin/

    - name: Run MCP Scan
      run: |
        mcp-sentinel scan ./ --output sarif --output-file mcp-scan.sarif

    - name: Upload SARIF report to GitHub
      uses: github/codeql-action/upload-sarif@v2
      with:
        sarif_file: mcp-scan.sarif
